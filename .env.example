# PostgreSQL パスワード（postgres・backend 両サービスで使用）
POSTGRES_PASSWORD=change_me

# Django シークレットキー（本番環境では必ず変更すること）
DJANGO_SECRET_KEY=change_me

# 許可するホスト名（カンマ区切り）。ローカルはデフォルト(localhost)のままでよい
# 本番環境では具体的なドメインを指定すること
# ALLOWED_HOSTS=example.com,www.example.com

# CORS 許可オリジン（カンマ区切り）。本番環境では具体的なオリジンを指定すること
# CORS_ORIGIN=https://example.com
