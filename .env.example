# ============================================================
# お絵描きチャット Neo — 環境変数テンプレート
# cp .env.example .env して、各値を設定してください。
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
# postgres・backend 両サービスで共有されるパスワード
POSTGRES_PASSWORD=change_me

# ── Django ───────────────────────────────────────────────────
# 必ず長くランダムな文字列に変更すること（例: python -c "import secrets; print(secrets.token_hex(32))"）
DJANGO_SECRET_KEY=change_me

# デバッグモード（本番環境では false のままにすること）
# DEBUG=false

# 許可するホスト名（カンマ区切り）。ローカルはデフォルト(localhost)のままでよい
# 本番環境では具体的なドメインを指定すること
# ALLOWED_HOSTS=example.com,www.example.com

# CORS 許可オリジン（カンマ区切り）。本番環境では具体的なオリジンを指定すること
# CORS_ORIGIN=https://example.com

# OAuth コールバック URL のプロトコル。
# ローカル開発（HTTP）: 設定不要（docker-compose が http をデフォルト値として渡す）
# 本番 HTTPS 環境: https に変更すること
# ACCOUNT_DEFAULT_HTTP_PROTOCOL=https

# ── Google SSO (django-allauth) ───────────────────────────────
# Google Cloud Console で OAuth 2.0 クライアント ID を発行して設定する。
# 設定手順:
#   1. https://console.cloud.google.com/ → 「APIとサービス」→「認証情報」
#   2. 「認証情報を作成」→「OAuth クライアント ID」→ アプリケーション種類: ウェブアプリケーション
#   3. 承認済みのリダイレクト URI に以下を追加:
#      - http://localhost:8080/accounts/google/login/callback/  （開発環境）
#      - https://your-domain.com/accounts/google/login/callback/ （本番環境）
#   4. 発行されたクライアントID / クライアントシークレットを以下に設定
#
# ※ 未設定でも「メールアドレス＋パスワード」でのログインは利用可能
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── メール送信 ────────────────────────────────────────────────
# 開発環境: コンソールに出力（デフォルト）
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
#
# 本番環境: SMTP を使う場合は以下をコメントアウト解除して設定
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=your_smtp_password
# DEFAULT_FROM_EMAIL=お絵描きチャット <noreply@example.com>
